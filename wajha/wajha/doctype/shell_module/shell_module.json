{
 "doctype": "DocType",
 "name": "Shell Module",
 "module": "Wajha",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "editable_grid": 1,
 "engine": "InnoDB",
 "allow_rename": 0,
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "sec_id",
  "module_key",
  "module_label",
  "module_label_en",
  "col_i1",
  "icon",
  "group",
  "sequence",
  "enabled",
  "auto_generated",
  "sec_view",
  "view_type",
  "ref_doctype",
  "route",
  "col_v1",
  "page_length",
  "sort_field",
  "sort_order",
  "search_fields",
  "status_field",
  "sec_scope",
  "scope",
  "scope_field",
  "col_s1",
  "detail_fields",
  "form_fields",
  "show_in_mobile_bar",
  "auto_actions",
  "sec_cols",
  "columns",
  "sec_filters",
  "filters",
  "sec_map",
  "show_map",
  "map_lat_field",
  "map_lon_field",
  "col_m1",
  "map_label_field",
  "map_color_field",
  "map_center_lat",
  "map_center_lon",
  "map_zoom",
  "sec_actions",
  "actions"
 ],
 "fields": [
  {
   "fieldname": "sec_id",
   "fieldtype": "Section Break",
   "label": "تعريف الوحدة"
  },
  {
   "fieldname": "module_key",
   "fieldtype": "Data",
   "label": "المعرّف البرمجي",
   "reqd": 1,
   "unique": 1,
   "description": "حروف لاتينية صغيرة بدون مسافات، مثل: assets",
   "in_list_view": 1
  },
  {
   "fieldname": "module_label",
   "fieldtype": "Data",
   "label": "العنوان",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "module_label_en",
   "fieldtype": "Data",
   "label": "العنوان بالإنجليزية",
   "in_list_view": 1
  },
  {
   "fieldname": "col_i1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "icon",
   "fieldtype": "Data",
   "label": "الأيقونة",
   "description": "رمز تعبيري أو اسم أيقونة Frappe"
  },
  {
   "fieldname": "group",
   "fieldtype": "Data",
   "label": "المجموعة",
   "description": "لتجميع الوحدات الثانوية في الشريط الجانبي"
  },
  {
   "fieldname": "sequence",
   "fieldtype": "Int",
   "label": "الترتيب",
   "default": "10",
   "in_list_view": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "مُفعّلة",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "sec_view",
   "fieldtype": "Section Break",
   "label": "نوع العرض"
  },
  {
   "fieldname": "view_type",
   "fieldtype": "Select",
   "label": "نوع العرض",
   "options": "List\nRoute Link",
   "default": "List",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "ref_doctype",
   "fieldtype": "Link",
   "label": "الـ DocType",
   "options": "DocType",
   "depends_on": "eval:doc.view_type=='List'",
   "in_list_view": 1
  },
  {
   "fieldname": "route",
   "fieldtype": "Data",
   "label": "المسار",
   "depends_on": "eval:doc.view_type=='Route Link'",
   "description": "مثال: /app/query-report/..."
  },
  {
   "fieldname": "col_v1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "page_length",
   "fieldtype": "Int",
   "label": "عدد السجلات في الصفحة",
   "default": "20"
  },
  {
   "fieldname": "sort_field",
   "fieldtype": "Data",
   "label": "حقل الترتيب",
   "default": "modified"
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Select",
   "label": "اتجاه الترتيب",
   "options": "DESC\nASC",
   "default": "DESC"
  },
  {
   "fieldname": "search_fields",
   "fieldtype": "Small Text",
   "label": "حقول البحث",
   "description": "أسماء حقول مفصولة بفواصل تُستخدم في البحث الحر"
  },
  {
   "fieldname": "status_field",
   "fieldtype": "Data",
   "label": "حقل الحالة",
   "description": "اختياري. للمستندات القابلة للاعتماد يُستخدم docstatus تلقائيًا (مسودة/معتمد/ملغى) دون الحاجة لتعبئة هذا الحقل."
  },
  {
   "fieldname": "sec_cols",
   "fieldtype": "Section Break",
   "label": "الأعمدة",
   "depends_on": "eval:doc.view_type=='List'"
  },
  {
   "fieldname": "columns",
   "fieldtype": "Table",
   "label": "الأعمدة",
   "options": "Shell Module Column"
  },
  {
   "fieldname": "sec_filters",
   "fieldtype": "Section Break",
   "label": "عوامل التصفية",
   "depends_on": "eval:doc.view_type=='List'"
  },
  {
   "fieldname": "filters",
   "fieldtype": "Table",
   "label": "عوامل التصفية",
   "options": "Shell Module Filter"
  },
  {
   "fieldname": "sec_map",
   "fieldtype": "Section Break",
   "label": "الخريطة (اختياري)",
   "collapsible": 1,
   "depends_on": "eval:doc.view_type=='List'"
  },
  {
   "fieldname": "show_map",
   "fieldtype": "Check",
   "label": "عرض خريطة"
  },
  {
   "fieldname": "map_lat_field",
   "fieldtype": "Data",
   "label": "حقل خط العرض",
   "depends_on": "show_map"
  },
  {
   "fieldname": "map_lon_field",
   "fieldtype": "Data",
   "label": "حقل خط الطول",
   "depends_on": "show_map"
  },
  {
   "fieldname": "col_m1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "map_label_field",
   "fieldtype": "Data",
   "label": "حقل التسمية",
   "depends_on": "show_map"
  },
  {
   "fieldname": "map_color_field",
   "fieldtype": "Data",
   "label": "حقل التلوين",
   "depends_on": "show_map",
   "description": "حقل نصي/اختياري تُشتق منه ألوان النقاط"
  },
  {
   "fieldname": "map_center_lat",
   "fieldtype": "Float",
   "label": "مركز الخريطة - خط العرض",
   "depends_on": "show_map",
   "precision": "6"
  },
  {
   "fieldname": "map_center_lon",
   "fieldtype": "Float",
   "label": "مركز الخريطة - خط الطول",
   "depends_on": "show_map",
   "precision": "6"
  },
  {
   "fieldname": "map_zoom",
   "fieldtype": "Int",
   "label": "مستوى التقريب",
   "default": "10",
   "depends_on": "show_map"
  },
  {
   "fieldname": "sec_scope",
   "fieldtype": "Section Break",
   "label": "النطاق والتفاصيل"
  },
  {
   "fieldname": "scope",
   "fieldtype": "Select",
   "label": "نطاق السجلات",
   "options": "All\nMine (Owner)\nMine (User Field)\nMine (Employee Field)",
   "default": "All",
   "description": "All: every record the user's roles allow. Mine: only the user's own records — by owner, by a field holding the user id, or by a field holding the Employee linked to the user. A self-service module for employees is a Mine module."
  },
  {
   "fieldname": "scope_field",
   "fieldtype": "Data",
   "label": "حقل النطاق",
   "depends_on": "eval:doc.scope && doc.scope !== 'All' && doc.scope !== 'Mine (Owner)'",
   "mandatory_depends_on": "eval:doc.scope && doc.scope !== 'All' && doc.scope !== 'Mine (Owner)'",
   "description": "The fieldname compared against the user (User Field) or the user's Employee (Employee Field), e.g. employee."
  },
  {
   "fieldname": "col_s1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "detail_fields",
   "fieldtype": "Small Text",
   "label": "حقول بطاقة التفاصيل",
   "description": "Comma-separated fieldnames shown on the record card, in order. Blank shows every readable, non-empty field grouped by the form's own sections."
  },
  {
   "fieldname": "show_in_mobile_bar",
   "fieldtype": "Check",
   "label": "في شريط الجوال",
   "default": "0",
   "description": "Pin this module to the bottom bar on phones (the first four flagged modules; the first four modules when none is flagged)."
  },
  {
   "fieldname": "auto_actions",
   "fieldtype": "Check",
   "label": "إجراءات تلقائية",
   "default": "1",
   "description": "Offer the record's workflow transitions, or Submit / Cancel when it has no workflow, on the record card. Frappe's own permissions decide who sees which."
  },
  {
   "fieldname": "sec_actions",
   "fieldtype": "Section Break",
   "label": "إجراءات إضافية",
   "collapsible": 1
  },
  {
   "fieldname": "actions",
   "fieldtype": "Table",
   "label": "الإجراءات",
   "options": "Shell Module Action"
  },
  {
   "fieldname": "form_fields",
   "fieldtype": "Small Text",
   "label": "حقول نموذج الإنشاء",
   "description": "Comma-separated fieldnames for the in-shell New form, in order. Blank offers the DocType's mandatory fields. The scope field is always filled by the server."
  },
  {
   "fieldname": "auto_generated",
   "fieldtype": "Check",
   "label": "مولّدة تلقائيًا",
   "default": "0",
   "read_only": 1,
   "description": "Created by a Wajha pack (e.g. HRMS self-service). Edit freely; packs only fill blanks and never overwrite."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Shell Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "All",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "email": 1,
   "export": 1,
   "print": 1,
   "report": 1,
   "share": 1
  }
 ],
